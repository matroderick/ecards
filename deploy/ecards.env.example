# /etc/far-app.env   (chmod 640, owner root:www-data)
# Required
FAR_BASE_DOMAIN=cards.example.com       # cards at <handle>.cards.example.com, sign-in at app.cards.example.com
FAR_SCHEME=https
FAR_ADMINS=you@example.com              # comma-separated; these emails see /admin and approve invite requests
FAR_SMTP_HOST=smtp.example.com          # any SMTP server that can send as FAR_MAIL_FROM
FAR_SMTP_PORT=465
FAR_SMTP_USER=CHANGE_ME
FAR_SMTP_PASS=CHANGE_ME
# Optional
FAR_SITE_NAME=ecards                    # product name in pages and emails
FAR_MAIL_FROM=ecards <login@example.com>
FAR_CONTACT=contact@example.com         # shown in Terms/Privacy and on every card's privacy notice
FAR_IMPROVMX_KEY=                       # enables per-user handle@domain email forwarding (ImprovMX API key)
